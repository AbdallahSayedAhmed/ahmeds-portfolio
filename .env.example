# Copy this file to `.env` locally, or set the same values in your hosting provider.
# Never commit the real `.env` file.

NODE_ENV=production
DASHBOARD_PUBLIC=true
HOST=127.0.0.1
PORT=4174

# Generate strong values:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DASHBOARD_PASSWORD=replace-with-a-strong-private-password
DASHBOARD_SECRET=replace-with-a-random-32-byte-secret

# If the dashboard is served through HTTPS, keep secure cookies enabled.
# Set to false only for local HTTP testing.
DASHBOARD_SECURE_COOKIE=true

# Set TRUST_PROXY=true only when a trusted reverse proxy sends X-Forwarded-For.
TRUST_PROXY=false

# Anti-bruteforce limits.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_MAX_ATTEMPTS=8
AUTH_RECOVERY_MAX_ATTEMPTS=5
AUTH_CODE_MAX_ATTEMPTS=8

# Forgot-password owner email and SMTP provider.
DASHBOARD_RESET_EMAIL=ahmedbashamahmoud175@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com
